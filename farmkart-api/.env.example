# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=farmkart
DB_PASSWORD=your_password_here
DB_NAME=farmkart
DB_SSLMODE=disable

# Security / JWT
JWT_SECRET=change_me_run_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=10080

# CORS (web build only; comma-separated; '*' is rejected in production)
CORS_ORIGINS=

# Google Sign-In: OAuth client IDs whose tokens are accepted (comma-separated). Empty disables it.
GOOGLE_CLIENT_IDS=

# Public contact for privacy, support and account-deletion requests (required in production)
SUPPORT_EMAIL=itsmesivarajr@gmail.com

# Environment (development | test | production). Defaults to production when unset.
ENV=development

# Sentry DSN (optional - error reporting)
SENTRY_DSN=

# MSG91 SMS Gateway (required in production)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Delivery rules
FREE_DELIVERY_RADIUS_KM=50
MAX_EXTENDED_DELIVERY_KM=0

# AWS S3 (optional - leaves empty to fallback to local uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
# Optional CDN base URL for uploaded images (e.g. CloudFront)
S3_PUBLIC_BASE_URL=

# Server (start.sh)
GUNICORN_WORKERS=2
# Load balancer IPs allowed to set X-Forwarded-For (needed for correct rate limiting behind a proxy)
FORWARDED_ALLOW_IPS=127.0.0.1
