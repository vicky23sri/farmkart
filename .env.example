# FarmKart Mobile App Environment Variables
# For local development with FastAPI backend on port 8000:
# Emulators:
#   Android Emulator: http://10.0.2.2:8000
#   iOS Simulator / Web: http://localhost:8000
# Physical devices on the same Wi-Fi:
#   Use your local LAN IP (e.g., http://192.168.1.100:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000
# Sentry DSN for error reporting in mobile app (optional)
EXPO_PUBLIC_SENTRY_DSN=
# Google Sign-In (optional; the button is hidden when unset). See DEPLOY.md > Google Sign-In.
# WEB client ID (not the Android one): ID tokens are issued for it, and the API's
# GOOGLE_CLIENT_IDS must list it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID, only needed for iOS builds
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Public contact shown in the privacy policy (defaults to the address in src/constants/contact.ts)
EXPO_PUBLIC_SUPPORT_EMAIL=
